// California State Scheduling — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id           String           @id @default(cuid())
  name         String
  address      String
  address2     String           @default("")
  city         String
  state        String           @default("CA")
  zip          String
  phone        String
  contactName  String           @default("")
  active       Boolean          @default(true)
  doctors      Doctor[]         @relation("DoctorLocations")
  schedules    DoctorSchedule[]
  appointments Appointment[]
  createdAt    DateTime         @default(now())
}

model Specialty {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String   @default("")
  category        String   @default("MEDICAL")
  durationMinutes Int      @default(30)
  doctors         Doctor[] @relation("DoctorSpecialties")
  appointments    Appointment[]
  overrides       DoctorSpecialtyOverride[]
  createdAt       DateTime @default(now())
}

model Exam {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  category        String   @default("MEDICAL")
  durationMinutes Int      @default(30)
  active          Boolean  @default(true)
  doctors         Doctor[] @relation("DoctorExams")
  createdAt       DateTime @default(now())
}

model Doctor {
  id           String           @id @default(cuid())
  name         String
  firstName    String           @default("")
  lastName     String           @default("")
  suffix       String           @default("")
  certStatus   String           @default("BC")
  languages    String           @default("")
  claimantAges String           @default("")
  remarks      String           @default("")
  allowVCE     Boolean          @default(false)
  active       Boolean          @default(true)
  notes        String           @default("")
  specialties  Specialty[]      @relation("DoctorSpecialties")
  locations    Location[]       @relation("DoctorLocations")
  exams        Exam[]           @relation("DoctorExams")
  schedules    DoctorSchedule[]
  appointments Appointment[]
  overrides    DoctorSpecialtyOverride[]
  createdAt    DateTime         @default(now())
}

model DoctorSpecialtyOverride {
  id              String    @id @default(cuid())
  doctor          Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId        String
  specialty       Specialty @relation(fields: [specialtyId], references: [id])
  specialtyId     String
  durationMinutes Int
  createdAt       DateTime  @default(now())

  @@unique([doctorId, specialtyId])
  @@index([doctorId])
}

model DoctorSchedule {
  id                     String   @id @default(cuid())
  doctor                 Doctor   @relation(fields: [doctorId], references: [id])
  doctorId               String
  location               Location @relation(fields: [locationId], references: [id])
  locationId             String
  startTime              DateTime
  endTime                DateTime
  slotType               String   @default("ANY")
  bookingDurationMinutes Int?
  // Psych schedules can opt into up to 1 AM + 1 PM extra MSE squeezes that
  // fill open gaps left after the normal cadence + dynamic slot rules.
  allowsSqueezes         Boolean  @default(false)
  // Squeeze 2: the cadence starts with a 30-min MSE squeeze (and another at
  // the first slot >= noon when the window spans noon), then resets to
  // normal MSE/Testing cadence. The last slot may run up to 30 min past
  // window end. Mutually compatible with `allowsSqueezes`.
  squeeze2               Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@index([locationId, startTime])
  @@index([doctorId, startTime])
}

model Template {
  id             String         @id @default(cuid())
  name           String         @unique
  disableAutoAdj Boolean        @default(false)
  times          TemplateTime[]
  createdAt      DateTime       @default(now())
}

model TemplateTime {
  id         String   @id @default(cuid())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  hour       Int
  minute     Int
  slotType   String   @default("ANY")
  createdAt  DateTime @default(now())

  @@index([templateId])
}

enum AppointmentStatus {
  SCHEDULED
  KEPT
  NO_SHOW
  CANCELLED
  MOVED
  OTHER
}

enum CancelledBy {
  BRANCH
  VENDOR
}

enum ScheduledBy {
  BRANCH
  VENDOR
}

enum MovedBy {
  BRANCH
  VENDOR
}

model Appointment {
  id                 String            @id @default(cuid())
  doctor             Doctor            @relation(fields: [doctorId], references: [id])
  doctorId           String
  location           Location          @relation(fields: [locationId], references: [id])
  locationId         String
  specialty          Specialty         @relation(fields: [specialtyId], references: [id])
  specialtyId        String
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  caseNumber         String
  firstInitial       String
  lastNamePrefix     String
  stateBranch        String
  analystName        String
  analystPhone       String
  analystExt         String            @default("")
  schedulerName      String
  schedulerPhone     String
  schedulerExt       String            @default("")
  claimantPhone      String            @default("")
  contractNumber     String            @default("")
  hasInterpreter     String            @default("no")
  isOdarCase         String            @default("no")
  notes              String            @default("")
  status             AppointmentStatus @default(SCHEDULED)
  statusNote         String            @default("")
  scheduledBy        ScheduledBy       @default(VENDOR)
  cancelledBy        CancelledBy?
  cancelledByName    String            @default("")
  cancelledAt        DateTime?
  movedBy            MovedBy?
  movedByName        String            @default("")
  movedAt            DateTime?
  isLateCancellation Boolean           @default(false)
  createdAt          DateTime          @default(now())

  @@index([caseNumber])
  @@index([status])
  @@index([doctorId, startTime])
  @@index([locationId, startTime])
}

model StateBranch {
  id           String   @id @default(cuid())
  name         String   @unique
  loginId      String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
}

enum NotificationPref {
  ALWAYS
  LIMITED
  NEVER
}

// Singleton — only one Vendor row is expected. Tracks the business profile
// shown on /vendor-setup/profile and the email address that receives
// cancel/reschedule notifications.
model Vendor {
  id                     String           @id @default(cuid())
  name                   String           @default("")
  address                String           @default("")
  address2               String           @default("")
  city                   String           @default("")
  state                  String           @default("CA")
  zip                    String           @default("")
  phone                  String           @default("")
  fax                    String           @default("")
  email                  String           @default("")
  loginId                String           @default("")
  password               String           @default("") // legacy; superseded by passwordHash
  passwordHash           String?
  // Optional shared "any branch" login: when these are set, a State analyst
  // can sign in once and book/view appointments for any branch instead of
  // needing per-branch credentials. Per-branch credentials on StateBranch
  // still work in parallel for branches that want strict scoping.
  branchLoginId          String           @default("")
  branchPasswordHash     String?
  contactName            String           @default("")
  appointmentNotification NotificationPref @default(LIMITED)
  description            String           @default("")
  newAppointments        Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}
